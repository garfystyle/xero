when player_join {
    send_message("Привет, %player%!")
    @all send_message("%player% зашёл на сервер")
    give_items(item(diamond, 5))
    kit(3)
}

when player_kill_player {
    game kills += 1
    if kills == 10 {
        @killer send_message("Десятое убийство на сервере — твоё!")
    } else if kills > 10 {
        send_message("Убийств: %var(kills)")
    } else {
        send_message("Ещё не десять")
    }
}

func kit(amount: number = 1) {
    give_items(item(iron_ingot, 2))
    if not has_item(item(bread)) {
        give_items(item(bread))
    }
    return
}

when world_start {
    add_custom_crafting_recipe("ruby_sword", item(diamond_sword), [
        _, item(emerald), _,
        _, item(emerald), _,
        _, item(stick),   _,
    ], recipe_type: shaped)
    save `рекорд` = 0
    x = get_list_value([1, 2, 3], 1)
    repeat.multi_times(i, 3) {
        wait(1, time_unit: seconds)
        play_sound(sound(entity.player.levelup, pitch: 2))
    }
}
